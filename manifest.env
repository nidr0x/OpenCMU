# OpenCMU payload manifest.
# This file is sourced by the installer. Keep values shell-safe.

MANIFEST_SCHEMA=1
PROJECT_NAME="OpenCMU"
PROJECT_VERSION="0.1.0"

# JCI_SW_VER range accepted by this payload.
# Only v74.00.324 has been written against. Widen the range only after
# testing the exact build on a bench unit.
FIRMWARE_MIN="74.00.324"
FIRMWARE_MAX="74.00.324"

# Tweaks applied when --tweaks is not passed.
DEFAULT_TWEAKS="00-example"
