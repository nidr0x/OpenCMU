TWEAK_NAME="Install the Android Auto touch shim"
TWEAK_RISK="high"
TWEAK_EXPERIMENTAL=1
TWEAK_DESCRIPTION="Copies a user-supplied libpatch-blmjciaapa.so to /data_persist/oem-aa-mod and writes libpatch.conf with only touch enabled. OpenCMU does not ship that shim: it is AGPL-3.0 and comes from oem-aa-mod. Requires OPENCMU_AATOUCH_SHIM and OPENCMU_AATOUCH_SHA256."
