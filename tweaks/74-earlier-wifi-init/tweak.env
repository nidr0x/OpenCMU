TWEAK_NAME="Earlier Wi-Fi init"
TWEAK_RISK="high"
TWEAK_EXPERIMENTAL=1
TWEAK_DESCRIPTION="Inserts a bounded wait for wlan0 before /jci/scripts/start_wifi.sh loads the WIFI modules. The wait gives up after ten seconds and never changes the module load order. The stock comment is used as the anchor; if it is not unique the tweak aborts without writing."
