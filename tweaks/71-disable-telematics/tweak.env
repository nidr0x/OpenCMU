TWEAK_NAME="Disable telematics"
TWEAK_RISK="high"
TWEAK_EXPERIMENTAL=1
TWEAK_DESCRIPTION="Switches off the telematics stack by setting autorun=no on its service blocks in /jci/sm/sm.conf. Emergency calling, driver identification and vehicle-data telematics stop after the next restart. Do not use where eCall or SOS is required."
