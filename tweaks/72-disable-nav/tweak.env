TWEAK_NAME="Disable navigation"
TWEAK_RISK="high"
TWEAK_EXPERIMENTAL=1
TWEAK_DESCRIPTION="Switches off the navigation service by setting autorun=no on its block in /jci/sm/sm.conf. The navigation app and map display stop after the next restart. Stock navigation is also what sends the unrestricted-touch message, so the cluster compass may disappear unless 61-keep-cluster-compass is installed."
