TWEAK_NAME="Enable touch in Android Auto"
TWEAK_RISK="high"
TWEAK_EXPERIMENTAL=1
TWEAK_DESCRIPTION="Declares the Android Auto touchscreen in both aap_system_attributes files, sets reset_board=\"no\" on jciAAPA and preloads the shim installed by tweak 58. Refuses when the shim is not already on the unit, so touch is never declared without a device behind it."
