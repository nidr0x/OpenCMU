    <!-- [opencmu:aa-touch] Android Auto touchscreen, primary input for AA -->
    <touch_screen>
        <use_internally>true</use_internally>
        <path>/dev/input/aa-touchscreen</path>
        <type>AAP_TOUCH_SCREEN_TYPE_CAPACITIVE</type>
        <as_secondary_input>false</as_secondary_input>
    </touch_screen>
