TWEAK_NAME="Track notification with artist"
TWEAK_RISK="low"
TWEAK_EXPERIMENTAL=1
TWEAK_DESCRIPTION="Shows artist and title in the USB audio track notification instead of the title alone. Rewrites the notification payload line in /jci/gui/apps/usbaudio/js/usbaudioApp.js. Bluetooth audio is not touched: its notification payload only carries the precombined titleInfo string, and the artist cannot be reconstructed without guessing."
