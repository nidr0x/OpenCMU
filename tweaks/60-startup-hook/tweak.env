TWEAK_NAME="Startup hook"
TWEAK_RISK="high"
TWEAK_EXPERIMENTAL=1
TWEAK_DESCRIPTION="Runs every executable *.sh in /data/opencmu/boot.d at boot, in the background, by appending a marked block to one stock stage script. No new Service Manager entry, no daemon, no wait on the boot path. Set OPENCMU_HOOK_STAGE to another stage script if needed."
