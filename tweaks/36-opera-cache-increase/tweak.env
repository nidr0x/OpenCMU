TWEAK_NAME="Enabled Opera disk cache"
TWEAK_RISK="low"
TWEAK_EXPERIMENTAL=1
TWEAK_DESCRIPTION="Enables the Opera disk cache ([Disk Cache] Enabled=0 to 1) and raises its size from 2000 KB to 8000 KB in /jci/opera/opera_home/opera.ini, so the UI redraws less from disk. The memory cache is left alone on purpose."
