TWEAK_NAME="Disable Stitcher"
TWEAK_RISK="high"
TWEAK_EXPERIMENTAL=1
TWEAK_DESCRIPTION="Switches off the Stitcher service by setting autorun=no on its block in /jci/sm/sm.conf. The shared internet-radio streaming server is left alone; disable it separately with 49-disable-internet-radio-servers when nothing else uses it."
